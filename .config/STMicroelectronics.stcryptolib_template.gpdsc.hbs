following this synthaxe--}}
{{!-- {{assign 'Comp_SW_Instances' (@root.SWConfigurationAPI.getInstances "STMicroelectronics::Device:STM32 HAL Code
Gen:I2C Init")~}}
{{!-- {{log "SW_Instances" @root.Comp_SW_Instances~}} --}}
{{!-- [3] All CodeGen common helpers described in this link
(https://github.com/PRG-Cube/cube-code-generation/blob/main/npm/code-generation-service/doc/README_helpers.md) are
already available for usage in this template --}}
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- ******************************************************************************
  * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
  * Description : Generator PDSC File generated by CodeGen
  ******************************************************************************
  * @attention
  *
