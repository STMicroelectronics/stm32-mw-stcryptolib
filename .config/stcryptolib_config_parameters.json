{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "function": [],
  "componentid": "Security::STM32CubeMX2 Config:STCryptoLib",
  "version": "1.0.0",
  "grammarVersion": "3.7.0",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "version": {
              "title": "Based on CMOX library version",
              "type": "string",
              "default": "4.0.4",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            }
          }
        },
        "profile": {
          "title": "Profile",
          "type": "object",
          "properties": {
            "stcryptolib_profile": {
              "title": "Profile selection",
              "type": "string",
              "oneOf": [
                {
                  "const": "fast_and_high",
                  "title": "Fast and High",
                  "description": "By default: fastest configurations possible."
                },
                {
                  "const": "small_and_low",
                  "title": "Small and Low",
                  "description": "Smallest configurations possible."
                },
                {
                  "const": "custom",
                  "title": "Custom",
                  "description": "To customize each item of the library."
                }
              ],
              "default": "fast_and_high",
              "description": "Optimizations and memory footprint of the library."
            }
          }
        },
        "core": {
          "title": "Core",
          "type": "object",
          "properties": {
            "basic": {
              "type": "object",
              "title": "Main features",
              "properties": {
                "aes_config": {
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Fast",
                      "const": "fast"
                    },
                    {
                      "title": "Small",
                      "const": "small"
                    }
                  ],
                  "title": "AES implementation",
                  "default": "fast",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$profile.stcryptolib_profile == 'small_and_low'",
                      "computed": {
                        "const": "small"
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$profile.stcryptolib_profile == 'fast_and_high'",
                      "computed": {
                        "const": "fast"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "$profile.stcryptolib_profile != 'custom'"
                    }
                  ]
                },
                "gcm_config": {
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Fast",
                      "const": "fast"
                    },
                    {
                      "title": "Small",
                      "const": "small"
                    }
                  ],
                  "title": "GCM implementation",
                  "default": "fast",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$profile.stcryptolib_profile == 'fast_and_high'",
                      "computed": {
                        "const": "fast"
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$profile.stcryptolib_profile == 'small_and_low'",
                      "computed": {
                        "const": "small"
